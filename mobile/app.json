{
  "expo": {
    "name": "recall-app",
    "slug": "recall-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recallapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "recall-app-2b6c6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.recallapp.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://recall-app.com"
        }
      ],
      [
        "expo-notifications"
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-apple-authentication"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "EXPO_PUBLIC_API_URL": "http://192.168.1.123:3000",
      "router": {
        "origin": "https://recall-app.com"
      },
      "eas": {
        "projectId": "6e593678-75aa-46d5-aece-74ce82752f25"
      }
    }
  }
}